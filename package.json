{
  "name": "eventhub",
  "version": "0.1.0",
  "private": true,
  "description": "EventHub: student club events with limited seats. Course project for Web Development, TU Sofia.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node src/server.js --dev",
    "build": "vite build",
    "start": "node src/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:coverage": "npm run coverage",
    "mcp": "node mcp-server/server.js",
    "mcp:check": "node mcp-server/check.mjs -- npm run --silent mcp",
    "mcp:token": "node scripts/mcp-token.js",
    "db:local": "node scripts/db-local.js",
    "db:stop": "node scripts/db-stop.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "jsdom": "30.1.2",
    "supertest": "7.3.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
