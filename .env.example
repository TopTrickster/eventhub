# Every environment variable EventHub reads, with empty or harmless values.
# Copy to .env for local use. Real values go into Render/Neon settings or Codespaces
# secrets, never into git. The browser never receives any of these.

NODE_ENV=development
PORT=3000
# Where the app is reached; also the base of the Google redirect URI.
APP_BASE_URL=http://localhost:3000

# PostgreSQL. Empty outside production means the local database from `npm run db:local`
# (postgres://postgres:postgres@localhost:5433/eventhub). Production: the Neon URL.
DATABASE_URL=
# Optional: run the tests against this database instead of a throwaway embedded one.
DATABASE_URL_TEST=

# Not used: sessions are opaque random tokens stored hashed, so nothing is signed.
# Kept because the course template lists it.
SESSION_SECRET=

# Sign in with Google (console.cloud.google.com, OAuth client, "Testing" mode).
# Add <APP_BASE_URL>/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to <APP_BASE_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# The AI event draft (aistudio.google.com). Without a key the app uses the fallback draft.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite

# A session token for the MCP server, from `npm run mcp:token`. It is one ordinary
# user's session and grants exactly what that user may do.
MCP_TOKEN=

# The demo seed's password. Required in production; locally it defaults to a test value.
SEED_PASSWORD=
